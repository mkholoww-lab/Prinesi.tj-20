# Prinesi.tj Courier Management System - Environment Variables
# Copy this file to .env and fill in your values

# GitHub Backup Integration (Optional)
# Get your token from: https://github.com/settings/tokens
VITE_GITHUB_TOKEN=your_github_personal_access_token_here

# GitHub Repository (format: username/repository)
# Create a new repository at https://github.com/new
VITE_GITHUB_REPO=your_username/your_repo_name

# GitHub Username
VITE_GITHUB_USER=your_github_username

# Application Name (Optional)
VITE_APP_NAME=Prinesi.tj Courier Management

# API Server URL (for future backend integration)
VITE_API_URL=http://localhost:3000

# Development settings
VITE_DEBUG_MODE=false
